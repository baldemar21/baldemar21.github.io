@charset "utf-8";

div#menu_u { width: auto; margin: 0px auto; font-family: Verdana, helvetica, sans-serif; font-size: 15px; color: rgb(170, 170, 170); text-align: left; font-weight: bold; height: auto; border-top: 5px solid rgb(254, 107, 26); }

div#fondo { width: auto; height: 20px; margin: 0px auto; background: url("BaseMenu.gif") repeat-x; border-left: 1px rgb(170, 170, 170); border-right: 1px rgb(170, 170, 170); padding: 5px; }

div#espacio { width: 100px; height: auto; margin-top: 0px; }

div#tabUno { width: 300px; height: 30px; margin: 0px; text-align: left; padding: 5px; }

div#aniRPC { position: absolute; margin: auto; }

div#closer { position: absolute; width: 100%; height: 100%; margin: auto; display: none; }

#umenu { list-style: none; margin: 0px; width: auto; height: 20px; text-align: right; background: url("/alum/css/pp.gif") no-repeat rgb(255, 255, 255); }

#umenu ul, li { padding: 0px; margin: 0px; list-style: none; }

#umenu li { background-color: rgb(254, 107, 26); text-align: center; font-family: Verdana, Arial, sans-serif; font-size: 10px; color: rgb(255, 255, 255); float: right; margin-left: 1px; margin-top: 0px; }

#umenu li:hover { border-top: 2px solid rgb(254, 107, 26); color: rgb(255, 255, 255); }

#umenu li a { display: block; font-weight: bold; text-decoration: none; color: rgb(255, 255, 255); }

#umenu li a:hover { font-weight: bold; text-decoration: underline; color: rgb(255, 255, 255); }

#imenu { list-style: none; margin: 0px; width: auto; height: 0px; text-align: left; background: rgb(255, 255, 255); }

#imenu ul, li { padding: 0px 3px 3px; margin: 1px; list-style: none; }

#imenu li { background-color: rgb(255, 255, 255); text-align: center; font-family: Verdana, Arial, sans-serif; font-size: 9px; color: rgb(51, 51, 51); float: left; margin: 0px; border-width: 2px 1px; border-style: solid outset; border-color: rgb(204, 204, 204) rgb(204, 204, 204) rgb(254, 107, 26); }

#imenu li:hover { background-color: rgb(233, 232, 235); border-left: 1px inset rgb(233, 232, 235); border-right: 1px inset rgb(233, 232, 235); color: rgb(0, 0, 0); }

#imenu li a { font-size: 9px; display: block; font-weight: bold; text-decoration: none; color: rgb(0, 0, 0); }

#imenu li a:hover { font-size: 9px; font-weight: bold; text-decoration: underline; color: rgb(0, 0, 0); }

.redon { display: block; }

.redon * { display: block; height: 1px; width: auto; overflow: hidden; background: rgb(254, 107, 26); }

.redon1 { margin-left: 3px; margin-right: 3px; padding-left: 1px; padding-right: 1px; border-left: 1px solid rgb(255, 255, 255); border-right: 1px solid rgb(255, 255, 255); border-bottom: 1px solid rgb(255, 255, 255); background: rgb(254, 107, 26); }

.redon2 { margin-left: 1px; margin-right: 1px; padding-right: 1px; padding-left: 1px; border-left: 1px solid rgb(255, 255, 255); border-right: 1px solid rgb(255, 255, 255); background: rgb(254, 107, 26); }

.redon3 { margin-left: 1px; margin-right: 1px; border-left: 1px solid rgb(255, 255, 255); border-right: 1px solid rgb(255, 255, 255); }

.redon4 { border-left: 1px solid rgb(255, 255, 255); border-right: 1px solid rgb(255, 255, 255); }

.redon5 { border-left: 1px solid rgb(255, 255, 255); border-right: 1px solid rgb(255, 255, 255); }

.redonfg { background: rgb(254, 107, 26); }
